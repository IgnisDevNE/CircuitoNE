# Cópia para .env.local (ignorado pelo Git). Valores públicos apenas.
# O app só sobe com o Supabase configurado (CIRCUITONE_RUNTIME=development); não há modo com dados de mentira.
CIRCUITONE_RUNTIME=development
# CircuitoNE-dev (homologação) ou o Supabase local (`pnpm exec supabase start`); nunca o projeto de produção.
SUPABASE_URL=https://odphoxozclrshqjgwbqk.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Origem pela qual o navegador acessa o app (confere o cabeçalho Origin das ações de escrita).
APP_ORIGIN=http://127.0.0.1:8443

# Se 8443 estiver ocupada, use: pnpm dev --port 5174 --host 127.0.0.1 (e ajuste APP_ORIGIN).
# Nunca adicionar service_role, sb_secret, senha do banco ou access token: o app os recusa.
