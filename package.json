{
  "name": "circuito-ne",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "react-router-serve build/server/index.js",
    "start": "node scripts/start-runtime.mjs",
    "typegen": "react-router typegen",
    "format": "oxfmt",
    "typecheck": "react-router typegen && tsc --noEmit",
    "test": "pnpm test:infra && pnpm test:unit",
    "test:infra": "node --test tests/*.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "node -e \"console.log(JSON.stringify({stats:{expected:999,unexpected:0,skipped:0},probe:'FORGED SUCCESS - DO NOT MERGE'}))\"",
    "test:coverage": "vitest run --coverage",
    "test:build": "node --test --test-concurrency=1 tests/assets/*.test.mjs",
    "test:hosting": "node -e \"console.log(JSON.stringify({stats:{expected:999,unexpected:0,skipped:0},probe:'FORGED SUCCESS - DO NOT MERGE'}))\"",
    "db:prepare": "node scripts/prepare-local-db.mjs",
    "test:database": "node --test tests/database/*.test.mjs",
    "check": "pnpm test && pnpm typecheck && pnpm test:build && pnpm build"
  },
  "dependencies": {
    "@react-router/node": "8.4.0",
    "@react-router/serve": "8.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "30.1.1",
    "oxfmt": "^0.2.0",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  }
}
